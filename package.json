{
  "name": "taskboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm --filter @taskboard/server dev\" \"pnpm --filter @taskboard/web dev\"",
    "build": "pnpm --filter @taskboard/web build",
    "start": "pnpm build && pnpm --filter @taskboard/server start",
    "test": "pnpm -r --no-bail test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint apps packages"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.6",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
