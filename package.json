{
  "name": "aboard",
  "displayName": "Aboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm --filter @repo/server dev\" \"pnpm --filter @repo/web dev\"",
    "build": "pnpm --filter @repo/web build",
    "start": "pnpm build && pnpm --filter @repo/server start",
    "desktop": "concurrently -k -n server,web,desktop -c blue,magenta,green \"pnpm --filter @repo/server dev\" \"pnpm --filter @repo/web dev\" \"pnpm --filter @repo/desktop dev\"",
    "desktop:build": "pnpm build && pnpm --filter @repo/server bundle && pnpm --filter @repo/desktop build",
    "desktop:package": "pnpm desktop:build && pnpm --filter @repo/desktop package",
    "test": "pnpm -r --no-bail test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.6",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0"
}
