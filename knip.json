{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {},
    "apps/web": {
      "entry": ["src/dev/**/*.tsx"],
      "ignore": ["src/components/ui/**"]
    },
    "apps/desktop": {
      "entry": ["src/main.ts", "src/preload.ts"]
    },
    "packages/contracts": {}
  },
  "ignoreBinaries": ["ffmpeg", "gifski"]
}
